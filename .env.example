# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=            # 32+ random characters

# Neon Postgres
DATABASE_URL=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase Auth (customer login with Google / email)
# Firebase console → Project settings → General → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=     # e.g. homefix-12345.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=      # e.g. homefix-12345
NEXT_PUBLIC_FIREBASE_APP_ID=

# Share of each completed job kept by HomeFix (percent). Defaults to 20.
COMMISSION_PERCENT=20
